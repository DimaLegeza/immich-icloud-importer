# Source this in any new terminal before running the migration:
#     cp session.env.example session.env   # then edit
#     source session.env
#
# None of the migration's progress lives in the shell -- that is all on disk in
# ~/.icloud-migrate and in the staging tree. These are only the settings, but
# getting one wrong has already cost two runs, so keep them in a file rather
# than retyping them.
#
# session.env is gitignored: it holds an Apple ID.

export ICLOUD_USER=someone@icloud.com        # the Apple ID being migrated,
                                             # NOT the Immich login
export STAGE=/Volumes/STAGING/icloud         # staging disk; must be dedicated,
                                             # its subdirectories get removed
                                             # once their contents are uploaded

# Omit the video half of Live Photos. icloudpd downloads it as a separate file
# and the Immich CLI cannot pair the two, so importing both gives you two
# assets per Live Photo. Run `preflight` to confirm the flag drops only the
# .MOV on your library before trusting this.
export SKIP_LIVE=1

# Assets per window for the legacy windowed passes. Pinned on first use and
# refused if it changes, because altering it mid-job would renumber the
# windows and lose the record of which are done. Irrelevant to `sync`.
export WINDOW_MAX=25000

# Stop staging more when free space on $STAGE drops below this many GB.
export MIN_FREE_GB=60

# Parallel uploads to Immich. 2 is a reasonable default; the receiving server
# is usually the bottleneck, not the network. Drop to 1 if uploads destabilise
# the destination -- on the reference setup an under-powered USB hub could not
# hold its link up with two drives writing at once.
export IMMICH_CONC=2

echo "session: $ICLOUD_USER | $STAGE | SKIP_LIVE=$SKIP_LIVE | WINDOW_MAX=$WINDOW_MAX | CONC=$IMMICH_CONC"
